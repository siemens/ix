{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Siemens ix Patterns Lockfile",
  "description": "Lockfile for ix patterns CLI tracking installed patterns and file hashes",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference"
    },
    "targetFolder": {
      "type": "string",
      "description": "Target folder where patterns are installed",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*[:?#\\\\%])(?!(?:.*/)?\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "default": "src/patterns"
    },
    "patterns": {
      "type": "array",
      "description": "List of installed patterns",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Pattern name"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Pattern version"
          },
          "files": {
            "type": "array",
            "description": "Installed files with content hashes",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?!.*[:?#\\\\%])(?!(?:.*/)?\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
                  "description": "Relative file path from project root"
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 content hash"
                }
              },
              "required": ["path", "hash"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "version"],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": ["targetFolder", "patterns"],
  "additionalProperties": false
}
