{
  "name": "@siemens/ix-cli",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ix": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "READMEOSS.html"
  ],
  "scripts": {
    "build": "pnpm run typecheck && pnpm run test && tsdown && cp src/ix-patterns.schema.json dist/",
    "dev": "cp src/ix-patterns.schema.json dist/ && tsdown --watch",
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "semver": "^7.6.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.5.8",
    "tsdown": "^0.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
