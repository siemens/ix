{
  "name": "@siemens/ix-svelte",
  "homepage": "https://ix.siemens.io",
  "author": "Siemens AG",
  "license": "MIT",
  "version": "5.2.1",
  "description": "Siemens iX for Svelte",
  "bugs": "https://github.com/siemens/ix/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/siemens/ix",
    "directory": "packages/svelte"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": [
    "**/*.svelte",
    "**/internal-components.js",
    "**/delegate.js"
  ],
  "scripts": {
    "build": "pnpm clean && svelte-package --input src/lib --output dist",
    "clean": "rimraf dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test.setup": "playwright install chromium --with-deps",
    "test": "vitest --config=vitest.config.ts run",
    "test.watch": "vitest --config=vitest.config.ts"
  },
  "dependencies": {
    "@siemens/ix": "~5.2.1"
  },
  "devDependencies": {
    "@siemens/ix": "workspace:*",
    "@siemens/ix-icons": "catalog:",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/browser": "^3.2.4",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.8.3",
    "vite": "catalog:",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0"
  },
  "peerDependencies": {
    "@siemens/ix-icons": "^3.5.0",
    "svelte": "^5.0.0"
  }
}
