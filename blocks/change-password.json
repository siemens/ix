          "source": "react-blocks/src/routes/change-password/change-password.module.css"
        }
      ]
    },
    "angular": {
      "files": [
        {
          "target": "angular/change-password.ts",
          "source": "angular-standalone-blocks/src/routes/change-password/change-password.ts"
        },
        {
          "target": "angular/change-password.html",
          "source": "angular-standalone-blocks/src/routes/change-password/change-password.html"
        },
        {
          "target": "angular/change-password.css",
          "source": "angular-standalone-blocks/src/routes/change-password/change-password.css"
        }
      ]
    }
