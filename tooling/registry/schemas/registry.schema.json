{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IX Unified Registry",
  "description": "Registry schema for Siemens IX patterns, examples and component metadata catalog",
  "type": "object",
  "required": ["name", "dist-tags", "versions"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Registry package name",
      "pattern": "^[a-z0-9-]+$"
    },
    "dist-tags": {
      "type": "object",
      "description": "Distribution tags mapping to version numbers",
      "required": ["latest"],
      "properties": {
        "latest": {
          "type": "string",
          "description": "Latest stable version",
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$"
      }
    },
    "versions": {
      "type": "object",
      "description": "Available versions and their catalog entries",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "$ref": "#/definitions/versionEntry"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "versionEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "patterns",
            "examples",
            "components",
            "documentationSearchIndex"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "description": "List of patterns available in this version",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/patternReference"
              }
            },
            "examples": {
              "type": "array",
              "description": "List of examples available in this version",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/exampleReference"
              }
            },
            "components": {
              "type": "object",
              "required": ["componentDoc", "componentRelatedExamples"],
              "properties": {
                "componentDoc": { "type": "string", "pattern": "\\.json$" },
                "componentRelatedExamples": {
                  "type": "string",
                  "pattern": "\\.json$"
                },
                "componentRelatedPatterns": {
                  "type": "string",
                  "pattern": "\\.json$"
                }
              },
              "additionalProperties": false
            },
            "documentationSearchIndex": {
              "type": "string",
              "description": "Versioned central MiniSearch documentation index",
              "pattern": "\\.json$"
            },
            "llms": {
              "type": "object",
              "description": "LLM-readable registry artifact files",
              "required": ["entrypoint", "components", "patterns"],
              "properties": {
                "entrypoint": { "type": "string", "pattern": "\\.txt$" },
                "components": { "type": "string", "pattern": "\\.md$" },
                "examples": { "type": "string", "pattern": "\\.md$" },
                "patterns": { "type": "string", "pattern": "\\.md$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/legacyVersionEntry"
        }
      ]
    },
    "legacyVersionEntry": {
      "type": "object",
      "required": ["patterns", "examples", "components", "searchIndex"],
      "properties": {
        "patterns": {
          "type": "array",
          "description": "List of patterns available in a historical version",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/patternReference"
          }
        },
        "examples": {
          "type": "array",
          "description": "List of examples available in a historical version",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/exampleReference"
          }
        },
        "components": {
          "type": "object",
          "required": [
            "componentDoc",
            "componentIndex",
            "componentSearchIndex",
            "componentRelatedExamples"
          ],
          "properties": {
            "componentDoc": { "type": "string", "pattern": "\\.json$" },
            "componentIndex": { "type": "string", "pattern": "\\.json$" },
            "componentSearchIndex": {
              "type": "string",
              "pattern": "\\.json$"
            },
            "componentRelatedExamples": {
              "type": "string",
              "pattern": "\\.json$"
            },
            "componentRelatedPatterns": {
              "type": "string",
              "pattern": "\\.json$"
            }
          },
          "additionalProperties": false
        },
        "llms": {
          "type": "object",
          "description": "LLM-readable registry artifact files",
          "required": ["entrypoint", "components", "patterns"],
          "properties": {
            "entrypoint": { "type": "string", "pattern": "\\.txt$" },
            "components": { "type": "string", "pattern": "\\.md$" },
            "examples": { "type": "string", "pattern": "\\.md$" },
            "patterns": { "type": "string", "pattern": "\\.md$" }
          },
          "additionalProperties": false
        },
        "searchIndex": {
          "type": "object",
          "description": "Legacy framework-specific MiniSearch indexes retained for historical versions",
          "required": ["patterns", "examples"],
          "properties": {
            "patterns": { "$ref": "#/definitions/frameworkSearchIndex" },
            "examples": { "$ref": "#/definitions/frameworkSearchIndex" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frameworkSearchIndex": {
      "type": "object",
      "properties": {
        "html": { "type": "string", "pattern": "\\.json$" },
        "react": { "type": "string", "pattern": "\\.json$" },
        "angular": { "type": "string", "pattern": "\\.json$" },
        "angular-standalone": { "type": "string", "pattern": "\\.json$" },
        "vue": { "type": "string", "pattern": "\\.json$" }
      },
      "additionalProperties": false
    },
    "patternReference": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Pattern identifier",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "description": "Relative path to pattern configuration file",
          "pattern": "\\.json$"
        }
      },
      "additionalProperties": false
    },
    "exampleReference": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Example identifier",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "description": "Relative path to example configuration file",
          "pattern": "\\.json$"
        }
      },
      "additionalProperties": false
    }
  }
}
