{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IX Block Definition",
  "description": "Schema for Siemens IX block definition files",
  "type": "object",
  "required": ["name", "description", "keywords", "preview", "variants"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preview": {
      "type": "string",
      "format": "uri-reference"
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "react": {
          "$ref": "#/definitions/variant"
        },
        "angular": {
          "$ref": "#/definitions/variant"
        },
        "vue": {
          "$ref": "#/definitions/variant"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/variant"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*[:?#\\\\%])(?!(?:.*/)?\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "dependency": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@siemens/[a-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "properties": {
              "source": {
                "$ref": "#/definitions/safeRelativePath"
              },
              "target": {
                "$ref": "#/definitions/safeRelativePath"
              }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dependency"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
