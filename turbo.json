{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "CI",
    "FIGMA_API_TOKEN",
    "GITHUB_TOKEN",
    "CSC",
    "BASE_URL",
    "REGISTRY_VERSION",
    "REGISTRY_PATH_PREFIX",
    "REGISTRY_LATEST_TAG",
    "CORPORATE_THEME_VERSION",
    "CORPORATE_THEME_URL"
  ],
  "globalPassThroughEnv": [
    "CORPORATE_THEME_TOKEN",
    "PLAYWRIGHT_BROWSERS_PATH",
    "CHROME_BIN"
  ],
  "globalDependencies": [".env*", "**/.env*"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "components/**",
        "hydrate/**",
        "dist/**",
        "dist-css/**",
        "build/**",
        "sboms/**",
        "storybook-static/**",
        "www/**",
        "loader/**",
        "api-docs/**",
        "component-api.json",
        "component-doc.json",
        "component-usage-by-component.json",
        "component-usage.json"
      ],
      "outputLogs": "new-only"
    },
    "registry#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "../../.agents/skills/ix/search.mjs"],
      "outputLogs": "new-only"
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": true,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "visual-regression": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "test.setup": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "test.memlab": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build.watch": {
      "cache": false
    },
    "storybook": {
      "persistent": true,
      "dependsOn": ["build.watch"],
      "cache": false
    }
  }
}
